      "kind": "custom",
      "description": "An itinerary item as a station on its day's line; the second row shows the selected state.",
      "html": "<div class=\"ds-line\" style=\"--line:#009E73\"><button class=\"ds-station\"><span class=\"ds-stn-mark\"></span><span class=\"ds-stn-time\">9:00 AM</span><span class=\"ds-stn-body\"><span class=\"ds-stn-title\">Senso-ji Temple</span><span class=\"ds-stn-place\">Senso-ji Temple</span><span class=\"ds-badge\">Planned</span></span><span class=\"ds-stn-cost\"></span></button><button class=\"ds-station is-selected\"><span class=\"ds-stn-mark\"></span><span class=\"ds-stn-time\">2:00 PM</span><span class=\"ds-stn-body\"><span class=\"ds-stn-title\">teamLab Planets</span><span class=\"ds-stn-place\">teamLab Planets</span><span><span class=\"ds-badge\">Reserved</span> <span class=\"ds-badge ds-badge-paid\">Paid</span></span></span><span class=\"ds-stn-cost\">$35</span></button></div>",
      "css": ".ds-line{position:relative;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;color:#121417;} .ds-line::before{content:\"\";position:absolute;left:12px;top:0;bottom:0;width:4px;background:var(--line);} .ds-station{position:relative;display:grid;grid-template-columns:28px 88px minmax(0,1fr) auto;gap:0 12px;width:100%;min-height:44px;padding:12px 12px 12px 0;border:0;border-radius:4.8px;background:transparent;text-align:left;cursor:pointer;font:inherit;color:inherit;transition:background-color .15s;} .ds-station:hover{background:#f3f4f2;} .ds-station:focus-visible{outline:2px solid #121417;outline-offset:2px;} .ds-station.is-selected::before{content:\"\";position:absolute;inset:0 0 0 32px;border-radius:4.8px;box-shadow:inset 0 0 0 2px #121417;pointer-events:none;} .ds-stn-mark{position:relative;z-index:1;justify-self:center;margin-top:5px;width:14px;height:14px;box-sizing:border-box;border-radius:9999px;border:3px solid var(--line);background:#fff;transition:scale .15s,background-color .15s;} .is-selected .ds-stn-mark{border-color:#121417;background:#121417;scale:1.25;} .ds-stn-time{font-size:14px;color:#5b616a;font-variant-numeric:tabular-nums;padding-top:2px;} .ds-stn-body{display:flex;flex-direction:column;gap:6px;min-width:0;} .ds-stn-title{font-size:17px;line-height:24px;font-weight:600;font-stretch:condensed;} .ds-stn-place{font-size:14px;color:#5b616a;} .ds-stn-cost{font-size:14px;font-weight:600;font-variant-numeric:tabular-nums;padding-top:2px;} .ds-badge{display:inline-flex;align-items:center;height:20px;padding:0 8px;border-radius:9999px;background:#eceeeb;color:#121417;font-size:12px;font-weight:500;width:fit-content;} .ds-badge-paid{background:#121417;color:#fff;}"
